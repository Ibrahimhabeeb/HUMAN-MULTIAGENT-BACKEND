        {"number": 9, "key": "security_advice_effort", "type": "number", "text": "How much effort did you need to expend to understand and assess the {mode}'s vulnerability, risk, and mitigation recommendations?", "scale": {"min": 0, "max": 100, "min_label": "Very low", "max_label": "Very high"}}
