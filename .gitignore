# Virtual environment (uv creates it; rebuild any time with `uv sync`)
.venv/

# Secrets: API keys live here. Never commit.
.env
.env.*
!.env.example
!.env.production.example
.release.env
.deployment.lock

# Python bytecode and build output
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Runtime data (session logs, sandboxed runs, local databases)
# Participant workspaces, snapshots and exports are study data: never commit them.
data/
workspaces/
snapshots/
results/
backups/
logs/
*.log
*.sqlite3
*.db

# Editor / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
