FROM python:3.13-slim

RUN python -m pip install --no-cache-dir pytest==9.1.1 bcrypt==5.0.0 fastapi==0.141.1 httpx==0.28.1
COPY deploy/test_entrypoint.py /opt/runner/test_entrypoint.py
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 65534:65534
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/python", "-I", "-B", "/opt/runner/test_entrypoint.py"]
